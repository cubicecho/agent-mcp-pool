{
  "name": "@cubicecho/agent-mcp-pool",
  "version": "0.2.1",
  "description": "A pool of long-lived Model Context Protocol clients, exposing every connected server's tools to an OpenAI-compatible agent loop as `<slug>__<tool>`.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openai",
    "agent",
    "tool-calling",
    "stdio",
    "streamable-http",
    "connection-pool",
    "typescript"
  ],
  "license": "MIT",
  "author": "Benjamin Van Treese <vantreeseba@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubicecho/agent-mcp-pool.git"
  },
  "homepage": "https://github.com/cubicecho/agent-mcp-pool#readme",
  "bugs": {
    "url": "https://github.com/cubicecho/agent-mcp-pool/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scripts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "node scripts/prepare.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.30",
    "openai": ">=6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.4.0",
    "openai": "^7.8.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
